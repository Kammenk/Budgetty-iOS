          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprettet på din telefon og derefter sendt til delemenuen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem Telefon erstellt und dann an das Teilen-Menü übergeben."
          }
        },
        "es" : {
          "stringUnit" : {
