    "Home also counts %@ of recurring bills this period. Overlay them here as a planned layer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home also counts %@ of recurring bills this period. Overlay them here as a planned layer."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начало също отчита %@ редовни сметки този период. Наслагвай ги тук като планиран слой."
