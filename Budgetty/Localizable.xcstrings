    "Bills aren't projected backwards, so months before you added them show spend only." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bills aren't projected backwards, so months before you added them show spend only."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сметките не се проектират назад, затова месеците преди да ги добавиш показват само похарченото."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účty se nepromítají zpětně, takže měsíce před jejich přidáním ukazují jen výdaje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regninger fremskrives ikke bagud, så måneder før du tilføjede dem viser kun forbruget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechnungen werden nicht rückwirkend projiziert, daher zeigen Monate, bevor du sie hinzugefügt hast, nur die Ausgaben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pagos no se proyectan hacia atrás, así que los meses anteriores a añadirlos muestran solo el gasto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskuja ei projisoida taaksepäin, joten niiden lisäämistä edeltävät kuukaudet näyttävät vain menot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les factures ne sont pas projetées en arrière, donc les mois précédant leur ajout n'affichent que les dépenses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le spese non vengono proiettate all'indietro, quindi i mesi prima di averle aggiunte mostrano solo la spesa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regninger projiseres ikke bakover, så måneder før du la dem til viser bare forbruket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekeningen worden niet met terugwerkende kracht geprojecteerd, dus maanden voordat je ze toevoegde tonen alleen de uitgaven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rachunki nie są rzutowane wstecz, więc miesiące sprzed ich dodania pokazują tylko wydatki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas não são projetadas para trás, então os meses antes de você adicioná-las mostram apenas o gasto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facturile nu sunt proiectate în urmă, așa că lunile de dinainte de a le adăuga arată doar cheltuielile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Счета не проецируются назад, поэтому месяцы до их добавления показывают только траты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räkningar projiceras inte bakåt, så månader innan du lade till dem visar bara utgifterna."
          }
        }
      }
    },
    "Category shares stay a percentage of the %@ you spent — planned bills are never in that total." : {
      "localizations" : {
