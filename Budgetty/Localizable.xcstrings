    "Built from savings, budget, goals, trend and subscriptions. Updates monthly." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На база спестявания, бюджет, цели, тенденция и абонаменти. Обновява се месечно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Založeno na spoření, rozpočtu, cílech, trendu a předplatných. Aktualizuje se měsíčně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bygget på opsparing, budget, mål, tendens og abonnementer. Opdateres hver måned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus Sparen, Budget, Zielen, Trend und Abos. Wird monatlich aktualisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basada en ahorro, presupuesto, objetivos, tendencia y suscripciones. Se actualiza cada mes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perustuu säästöihin, budjettiin, tavoitteisiin, trendiin ja tilauksiin. Päivittyy kuukausittain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basé sur l'épargne, le budget, les objectifs, la tendance et les abonnements. Mis à jour chaque mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basato su risparmio, budget, obiettivi, andamento e abbonamenti. Si aggiorna ogni mese."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bygget på sparing, budsjett, mål, trend og abonnementer. Oppdateres hver måned."
