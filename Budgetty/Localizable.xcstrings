    "Log a couple of weeks of spending and set a budget to unlock your Wellbeing score." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записвай разходите си няколко седмици и задай бюджет, за да отключиш оценката си за благополучие."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznamenávejte pár týdnů útrat a nastavte rozpočet, abyste odemkli své skóre pohody."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrér et par ugers forbrug og opret et budget for at låse din trivselsscore op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse ein paar Wochen Ausgaben und leg ein Budget fest, um deinen Wohlbefinden-Score freizuschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra un par de semanas de gastos y fija un presupuesto para desbloquear tu puntuación de bienestar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaa parin viikon menot ja aseta budjetti, niin saat hyvinvointipisteesi käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez quelques semaines de dépenses et définissez un budget pour débloquer votre score de bien-être."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra un paio di settimane di spese e imposta un budget per sbloccare il tuo punteggio di benessere."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrer et par uker med forbruk og sett et budsjett for å låse opp velværescoren din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg een paar weken uitgaven vast en stel een budget in om je welzijnsscore te ontgrendelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj wydatki przez kilka tygodni i ustaw budżet, aby odblokować swój wynik dobrostanu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre algumas semanas de gastos e defina um orçamento para desbloquear sua pontuação de bem-estar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrează câteva săptămâni de cheltuieli și setează un buget ca să-ți deblochezi scorul de bunăstare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывайте расходы пару недель и задайте бюджет, чтобы открыть оценку благополучия."
          }
        },
        "sv" : {
          "stringUnit" : {
