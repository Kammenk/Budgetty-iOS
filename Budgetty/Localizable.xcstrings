    "Saved bills show up in upcoming bills and count against Safe to spend until you mark them paid." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазените сметки се показват в предстоящите сметки и се броят срещу Свободни за харчене, докато не ги отбележиш като платени."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené účty se zobrazí v nadcházejících účtech a odečítají se od “Můžete utratit”, dokud je neoznačíte jako zaplacené."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemte regninger vises under kommende regninger og tæller mod “Til rådighed”, indtil du markerer dem som betalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Rechnungen erscheinen bei anstehenden Rechnungen und zählen gegen „Frei verfügbar“, bis du sie als bezahlt markierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pagos guardados aparecen en los próximos pagos y se descuentan de Puedes gastar hasta que los marques como pagados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennetut laskut näkyvät tulevissa laskuissa ja lasketaan mukaan Turvallista käyttää -summaan, kunnes merkitset ne maksetuiksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les factures enregistrées apparaissent dans les prochaines factures et sont déduites du Reste à dépenser jusqu'à ce que vous les marquiez comme payées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le spese salvate compaiono nelle prossime spese e vengono sottratte da Puoi spendere finché non le segni come pagate."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagrede regninger vises i kommende regninger og teller mot Trygt å bruke til du markerer dem som betalt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opgeslagen rekeningen verschijnen bij aankomende rekeningen en tellen mee tegen “Vrij besteedbaar” totdat je ze als betaald markeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisane rachunki pojawiają się w nadchodzących rachunkach i pomniejszają „Można wydać\", dopóki nie oznaczysz ich jako zapłacone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas salvas aparecem nas próximas contas e contam em Livre para gastar até você marcá-las como pagas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facturile salvate apar în facturile viitoare și contează în Sigur de cheltuit până le marchezi ca plătite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённые счета появляются в предстоящих счетах и уменьшают «Можно потратить», пока вы не отметите их оплаченными."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparade räkningar visas i kommande räkningar och räknas mot Tryggt att spendera tills du markerar dem som betalda."
          }
        }
      }
    },
