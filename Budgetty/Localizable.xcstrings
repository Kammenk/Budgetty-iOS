    "Created on your phone, then handed to the share sheet." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Създадено на твоя телефон и подадено към менюто за споделяне."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
