    "Even a small monthly amount gives your spare cash a job." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дори малка месечна сума дава задача на свободните ти пари."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I malá měsíční částka dá vašim volným penězům smysl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv et lille månedligt beløb giver dine ekstra penge et formål."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schon ein kleiner Monatsbetrag gibt deinem übrigen Geld eine Aufgabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque sea una pequeña cantidad al mes, le da un propósito a tu dinero libre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pienikin kuukausisumma antaa ylimääräisille rahoillesi tehtävän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même un petit montant mensuel donne un rôle à votre argent disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche un piccolo importo mensile dà uno scopo ai tuoi soldi liberi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv et lite månedlig beløp gir overskuddspengene dine en oppgave."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zelfs een klein maandbedrag geeft je overgebleven geld een bestemming."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawet mała miesięczna kwota daje wolnym środkom zadanie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo um valor pequeno por mês dá um propósito ao dinheiro que sobra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiar și o sumă mică pe lună dă un rost banilor rămași."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже небольшая сумма в месяц даёт свободным деньгам дело."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Även ett litet månadsbelopp ger dina extra pengar ett syfte."
          }
        }
      }
    },
