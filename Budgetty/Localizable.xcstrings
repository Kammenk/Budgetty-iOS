    "Closest so far: %lld charges from %@ — one more and we'll flag it." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Най-близо досега: %1$lld плащания от %2$@ — още едно и ще го отбележим."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejblíže zatím: %1$lld platby od %2$@ — ještě jedna a označíme to."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tættest indtil videre: %1$lld opkrævninger fra %2$@ — én mere, så markerer vi det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am nächsten bisher: %1$lld Zahlungen von %2$@ — eine mehr und wir markieren es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo más cerca hasta ahora: %1$lld cargos de %2$@ — uno más y lo marcaremos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähimpänä tähän mennessä: %1$lld maksua kaupasta %2$@ — vielä yksi, niin merkitsemme sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plus proche jusqu'ici : %1$lld prélèvements de %2$@ — un de plus et nous le signalerons."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il più vicino finora: %1$lld addebiti da %2$@ — ancora uno e lo segnaleremo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nærmest så langt: %1$lld betalinger fra %2$@ — én til, så flagger vi den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dichtstbij tot nu toe: %1$lld betalingen van %2$@ — nog eentje en we markeren het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najbliżej jak dotąd: %1$lld opłaty od %2$@ — jeszcze jedna i to oznaczymy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais próximo até agora: %1$lld cobranças de %2$@ — mais uma e vamos sinalizá-la."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cel mai aproape până acum: %1$lld plăți de la %2$@ — încă una și o vom semnala."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ближе всего: %1$lld списания от %2$@ — ещё одно, и мы это отметим."
          }
        },
