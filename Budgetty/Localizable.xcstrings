    "%@ → %@ from that charge onward. About %@ more over a year." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@ от това плащане нататък. Около %3$@ повече за година."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@ od té platby dále. Přibližně o %3$@ více za rok."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@ fra den opkrævning og frem. Omkring %3$@ mere over et år."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@ ab dieser Zahlung. Etwa %3$@ mehr pro Jahr."
