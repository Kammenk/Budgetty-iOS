    "Spending is %lld%% above your average of %@. Flat or falling scores full marks." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разходите са с %1$lld%% над средното ти %2$@. Без промяна или спад е пълен резултат."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útrata je o %1$lld%% nad vaším průměrem %2$@. Beze změny nebo pokles je plný počet bodů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbruget ligger %1$lld%% over dit gennemsnit på %2$@. Uændret eller faldende giver fuld score."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ausgaben liegen %1$lld%% über deinem Schnitt von %2$@. Gleichbleibend oder fallend gibt die volle Punktzahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Spending is %1$lld%% above your average of %2$@. Flat or falling scores full marks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El gasto está un %1$lld%% por encima de tu media de %2$@. Estable o a la baja obtiene la máxima puntuación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulutus on %1$lld%% yli keskiarvosi %2$@. Tasainen tai laskeva antaa täydet pisteet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dépenses sont %1$lld%% au-dessus de votre moyenne de %2$@. Stable ou en baisse, note maximale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le spese sono il %1$lld%% sopra la tua media di %2$@. Stabile o in calo ottiene il massimo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbruket er %1$lld%% over gjennomsnittet ditt på %2$@. Flatt eller fallende gir full pott."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitgaven liggen %1$lld%% boven je gemiddelde van %2$@. Gelijk of dalend geeft de volle score."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydatki są %1$lld%% powyżej Twojej średniej %2$@. Płaski lub spadkowy trend daje maksimum punktów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os gastos estão %1$lld%% acima da sua média de %2$@. Estável ou em queda garante nota máxima."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheltuielile sunt cu %1$lld%% peste media ta de %2$@. Constant sau în scădere ia punctaj maxim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расходы на %1$lld%% выше вашего среднего %2$@. Без роста или со снижением — максимальный балл."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utgifterna ligger %1$lld%% över ditt snitt på %2$@. Oförändrat eller minskande ger full poäng."
          }
        }
      }
    },
    "Spending is %lld%% below your average of %@. Flat or falling scores full marks." : {
      "localizations" : {
        "bg" : {
