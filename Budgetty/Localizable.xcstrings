    "%@ a month on subscriptions — %lld%% of what you spend. Under 5%% scores full marks." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ на месец за абонаменти — %2$lld%% от разходите ти. Под 5%% е пълен резултат."
