    "Monthly budget and planned bills apply to a single month." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Месечният бюджет и планираните сметки важат за един месец."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měsíční rozpočet a plánované platby platí pro jeden měsíc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Månedligt budget og planlagte regninger gælder for én måned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monatliches Budget und geplante Rechnungen gelten für einen einzelnen Monat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El presupuesto mensual y las facturas previstas se aplican a un solo mes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuukausibudjetti ja suunnitellut laskut koskevat yhtä kuukautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le budget mensuel et les factures prévues s'appliquent à un seul mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il budget mensile e le bollette previste valgono per un solo mese."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Månedlig budsjett og planlagte regninger gjelder for én måned."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maandbudget en geplande rekeningen gelden voor één maand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miesięczny budżet i zaplanowane rachunki dotyczą jednego miesiąca."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O orçamento mensal e as contas previstas aplicam-se a um único mês."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugetul lunar și facturile planificate se aplică unei singure luni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Месячный бюджет и запланированные счета относятся к одному месяцу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Månadsbudget och planerade räkningar gäller en enda månad."
          }
        }
      }
    },
    "Monthly spending budget" : {
