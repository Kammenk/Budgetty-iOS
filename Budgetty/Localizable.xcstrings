    "We'll spot recurring charges as you add more receipts. It usually takes about three charges from the same merchant." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще откриваме повтарящи се плащания, докато добавяш още бележки. Обикновено са нужни около три плащания от един и същ търговец."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opakované platby odhalíme, jakmile přidáte více účtenek. Obvykle jsou k tomu potřeba asi tři platby od stejného obchodníka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi registrerer gentagne opkrævninger, efterhånden som du tilføjer flere kvitteringer. Det kræver som regel omkring tre opkrævninger fra samme forhandler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erkennen wiederkehrende Zahlungen, sobald du mehr Belege hinzufügst. Meist braucht es etwa drei Zahlungen desselben Händlers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectaremos los cargos recurrentes a medida que añadas más recibos. Normalmente hacen falta unos tres cargos del mismo comercio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Havaitsemme toistuvat maksut, kun lisäät lisää kuitteja. Yleensä siihen tarvitaan noin kolme maksua samasta kaupasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous repérerons les prélèvements récurrents à mesure que vous ajoutez des reçus. Il faut généralement environ trois prélèvements du même commerçant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Individueremo gli addebiti ricorrenti man mano che aggiungi scontrini. Di solito servono circa tre addebiti dallo stesso commerciante."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi oppdager gjentatte betalinger etter hvert som du legger til flere kvitteringer. Det tar vanligvis omtrent tre betalinger fra samme butikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We ontdekken terugkerende betalingen naarmate je meer bonnen toevoegt. Meestal zijn er ongeveer drie betalingen van dezelfde verkoper voor nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykryjemy powtarzające się opłaty, gdy dodasz więcej paragonów. Zwykle potrzeba około trzech opłat od tego samego sprzedawcy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos identificar cobranças recorrentes à medida que você adiciona mais recibos. Normalmente são necessárias cerca de três cobranças do mesmo comerciante."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom depista plățile recurente pe măsură ce adaugi mai multe bonuri. De obicei sunt necesare cam trei plăți de la același comerciant."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы обнаружим повторяющиеся списания, когда вы добавите больше чеков. Обычно нужно около трёх списаний от одного продавца."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi upptäcker återkommande betalningar när du lägger till fler kvitton. Det brukar krävas ungefär tre betalningar från samma butik."
          }
        }
      }
    },
