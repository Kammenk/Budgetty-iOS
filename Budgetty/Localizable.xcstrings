    "The free plan includes 1 buying limit. Premium adds as many as you like — plus unlimited scans and custom categories." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безплатният план включва 1 лимит за покупки. Premium добавя колкото искаш — плюс неограничени сканирания и собствени категории."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezplatný plán obsahuje 1 limit nákupů. Premium přidá kolik chceš — plus neomezené skeny a vlastní kategorie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratisplanen indeholder 1 købsgrænse. Premium giver dig så mange, du vil — plus ubegrænsede scanninger og egne kategorier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kostenlose Plan enthält 1 Kauf-Limit. Mit Premium hast du so viele wie du möchtest — plus unbegrenzte Scans und eigene Kategorien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan gratuito incluye 1 límite de compra. Premium añade todos los que quieras — además de escaneos ilimitados y categorías propias."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmaisversio sisältää 1 ostorajan. Premium lisää niitä niin monta kuin haluat — sekä rajattomat skannaukset ja omat kategoriat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'offre gratuite inclut 1 limite d'achat. Premium en ajoute autant que tu veux — plus des scans illimités et des catégories personnalisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piano gratuito include 1 limite di acquisto. Premium ne aggiunge quanti ne vuoi — più scansioni illimitate e categorie personalizzate."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratisplanen inkluderer 1 kjøpsgrense. Premium gir deg så mange du vil — pluss ubegrensede skanninger og egne kategorier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gratis versie bevat 1 kooplimiet. Premium voegt er zo veel toe als je wilt — plus onbeperkt scannen en eigen categorieën."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan darmowy obejmuje 1 limit zakupów. Premium dodaje ich tyle, ile chcesz — plus nieograniczone skany i własne kategorie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plano gratuito inclui 1 limite de compra. O Premium adiciona quantos quiseres — mais digitalizações ilimitadas e categorias próprias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planul gratuit include 1 limită de cumpărare. Premium adaugă câte vrei — plus scanări nelimitate și categorii proprii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатный план включает 1 лимит покупок. С Premium их сколько угодно — плюс безлимитные сканы и свои категории."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratisplanen innehåller 1 köpgräns. Premium ger dig så många du vill — plus obegränsade skanningar och egna kategorier."
          }
        }
      }
    },
