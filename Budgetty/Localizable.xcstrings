    "Name it, pick a target, and track what you put aside — a new laptop, a trip, a rainy-day fund." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дай ѝ име, избери цел и следи какво заделяш — нов лаптоп, пътуване, фонд за черни дни."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojmenujte jej, zvolte cílovou částku a sledujte, co si odkládáte — nový notebook, cesta nebo rezerva na horší časy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv det et navn, vælg et mål, og følg det, du lægger til side — en ny laptop, en rejse, en nødopsparing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benenne es, wähle ein Ziel und verfolge, was du zurücklegst — ein neuer Laptop, eine Reise, ein Notgroschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponle nombre, elige una meta y controla lo que apartas — un portátil nuevo, un viaje, un fondo para imprevistos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna sille nimi, valitse tavoite ja seuraa, mitä laitat sivuun — uusi kannettava, matka tai vararahasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez-lui un nom, choisissez un objectif et suivez ce que vous mettez de côté — un nouvel ordinateur portable, un voyage, une épargne de précaution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagli un nome, scegli un obiettivo e monitora ciò che metti da parte — un nuovo portatile, un viaggio, un fondo per gli imprevisti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi det et navn, velg et mål, og følg det du setter av — en ny laptop, en reise, en buffer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef het een naam, kies een doel en volg wat je opzijzet — een nieuwe laptop, een reis, een appeltje voor de dorst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwij go, wybierz cel i śledź, co odkładasz — nowy laptop, podróż lub fundusz na czarną godzinę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê um nome, escolha um alvo e acompanhe o que separa — um notebook novo, uma viagem, um fundo de emergência."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dă-i un nume, alege o țintă și urmărește ce pui deoparte — un laptop nou, o călătorie, un fond pentru zile negre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте ей название, выберите цель и отслеживайте, что откладываете — новый ноутбук, поездка или запас на чёрный день."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge det ett namn, välj ett mål och följ vad du lägger undan — en ny laptop, en resa, en buffert."
          }
        }
      }
    },
