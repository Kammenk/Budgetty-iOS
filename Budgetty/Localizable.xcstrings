    "Detection runs on your device. Nothing leaves the phone, and no bank is connected." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разпознаването се извършва на устройството ти. Нищо не напуска телефона и няма свързана банка."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detekce probíhá ve vašem zařízení. Nic neopouští telefon a není připojena žádná banka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registreringen kører på din enhed. Intet forlader telefonen, og der er ingen bank tilsluttet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erkennung läuft auf deinem Gerät. Nichts verlässt das Telefon, und es ist keine Bank verbunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La detección se ejecuta en tu dispositivo. Nada sale del teléfono y no se conecta ningún banco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnistus tapahtuu laitteellasi. Mikään ei poistu puhelimesta, eikä pankkia ole yhdistetty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La détection s'exécute sur votre appareil. Rien ne quitte le téléphone et aucune banque n'est connectée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rilevamento avviene sul tuo dispositivo. Niente lascia il telefono e nessuna banca è collegata."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt oppdages på enheten din. Ingenting forlater telefonen, og ingen bank er tilkoblet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De detectie draait op je apparaat. Er verlaat niets de telefoon en er is geen bank gekoppeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykrywanie działa na Twoim urządzeniu. Nic nie opuszcza telefonu i żaden bank nie jest podłączony."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A detecção é feita no seu dispositivo. Nada sai do telefone e nenhum banco é conectado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectarea rulează pe dispozitivul tău. Nimic nu părăsește telefonul și nicio bancă nu este conectată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
