        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé %1$@, za právě skončený týden. Bez měsíčního přehledu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver %1$@, for ugen der lige er slut. Ingen månedsrapport."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
