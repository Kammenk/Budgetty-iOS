    "The %1$@ excludes %2$lld bill already matched to a receipt this period. Open Breakdown to see which." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %1$@ excludes %2$lld bill already matched to a receipt this period. Open Breakdown to see which."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ изключва %2$lld сметка, вече свързана с бележка този период. Отвори Разбивка, за да видиш коя."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vynechává %2$lld účet, který už je v tomto období spárován s účtenkou. Otevři Rozdělení a uvidíš který."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ udelader %2$lld regning, der allerede er matchet med en kvittering i denne periode. Åbn Fordeling for at se hvilken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ schließt %2$lld Rechnung aus, die in diesem Zeitraum bereits einem Beleg zugeordnet ist. Öffne die Aufschlüsselung, um zu sehen, welche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ excluye %2$lld pago ya vinculado a un recibo este período. Abre el Desglose para ver cuál."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ jättää pois %2$lld laskun, joka on jo yhdistetty kuittiin tällä jaksolla. Avaa Erittely nähdäksesi minkä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ exclut %2$lld facture déjà rapprochée d'un reçu sur cette période. Ouvrez la Répartition pour voir laquelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ esclude %2$lld spesa già abbinata a uno scontrino in questo periodo. Apri la Ripartizione per vedere quale."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ utelater %2$lld regning som allerede er matchet med en kvittering denne perioden. Åpne Fordeling for å se hvilken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ laat %2$lld rekening buiten beschouwing die deze periode al aan een bon is gekoppeld. Open de Verdeling om te zien welke."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pomija %2$lld rachunek już dopasowany do paragonu w tym okresie. Otwórz Podział, aby zobaczyć który."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ exclui %2$lld conta já associada a um recibo neste período. Abra o Detalhamento para ver qual."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ exclude %2$lld factură deja asociată cu un bon în această perioadă. Deschide Defalcare pentru a vedea care."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ не включает %2$lld счёт, уже сопоставленный с чеком в этом периоде. Откройте Разбивку, чтобы увидеть какой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ utelämnar %2$lld räkning som redan matchats mot ett kvitto den här perioden. Öppna Fördelning för att se vilken."
          }
        }
      }
    },
