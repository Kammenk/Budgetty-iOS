          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luodaan puhelimessasi ja siirretään sitten jakovalikkoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créé sur votre téléphone, puis transmis au menu de partage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creato sul tuo telefono, poi passato al menu di condivisione."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
