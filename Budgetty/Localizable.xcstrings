        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@ a partir de ese cargo. Unos %3$@ más al año."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@ kyseisestä maksusta alkaen. Noin %3$@ enemmän vuodessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@ à partir de ce prélèvement. Environ %3$@ de plus sur un an."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@ da quell'addebito in poi. Circa %3$@ in più in un anno."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@ fra og med den betalingen. Omtrent %3$@ mer i løpet av et år."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@ vanaf die betaling. Ongeveer %3$@ meer per jaar."
