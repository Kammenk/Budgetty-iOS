    "Creates a recurring bill — it then counts in Safe to spend and upcoming bills." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Създава повтаряща се сметка — след това се брои в Свободни за харчене и в предстоящите сметки."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvoří pravidelný účet — poté se počítá do “Můžete utratit” a nadcházejících účtů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opretter en fast regning — den tæller derefter med i “Til rådighed” og kommende regninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt eine wiederkehrende Rechnung — sie zählt dann bei „Frei verfügbar“ und anstehenden Rechnungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un pago recurrente — luego cuenta en Puedes gastar y en los próximos pagos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo toistuvan laskun — se lasketaan sitten mukaan Turvallista käyttää -summaan ja tuleviin laskuihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée une facture récurrente — elle compte alors dans Reste à dépenser et les prochaines factures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una spesa ricorrente — verrà poi conteggiata in Puoi spendere e nelle prossime spese."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppretter en fast regning — den teller deretter i Trygt å bruke og kommende regninger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt een terugkerende rekening — die telt daarna mee in “Vrij besteedbaar” en aankomende rekeningen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzy rachunek cykliczny — od tej pory liczy się w „Można wydać\" i nadchodzących rachunkach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria uma conta recorrente — passa a contar em Livre para gastar e nas próximas contas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creează o factură recurentă — apoi contează în Sigur de cheltuit și în facturile viitoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создаёт регулярный счёт — затем он учитывается в «Можно потратить» и предстоящих счетах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapar en återkommande räkning — den räknas sedan i Tryggt att spendera och kommande räkningar."
          }
        }
      }
    },
