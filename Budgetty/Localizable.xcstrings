    "Withdrawals lower your saved total. The goal stays where it is." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тегленията намаляват спестената сума. Целта остава същата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výběry sníží váš uspořený součet. Cíl zůstane beze změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hævninger sænker dit opsparede beløb. Målet forbliver det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abhebungen verringern deinen gesparten Betrag. Das Ziel bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las retiradas reducen tu total ahorrado. El objetivo se mantiene igual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostot pienentävät säästösummaasi. Tavoite pysyy ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les retraits diminuent votre total épargné. L'objectif reste inchangé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I prelievi riducono il totale risparmiato. L'obiettivo resta invariato."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uttak reduserer det du har spart. Målet blir stående."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opnames verlagen je gespaarde totaal. Het doel blijft ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wypłaty obniżają zaoszczędzoną sumę. Cel pozostaje bez zmian."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As retiradas reduzem o total economizado. A meta permanece igual."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retragerile îți scad totalul economisit. Obiectivul rămâne neschimbat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снятия уменьшают накопленную сумму. Цель остаётся прежней."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uttag sänker ditt sparade belopp. Målet ligger kvar."
          }
        }
      }
    },
    "Worked out on this phone from your own receipts and budgets. Nothing leaves the device." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изчислено на този телефон от твоите бележки и бюджети. Нищо не напуска устройството."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spočítáno v tomto telefonu z vašich vlastních účtenek a rozpočtů. Nic neopustí zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beregnet på denne telefon ud fra dine egne kvitteringer og budgetter. Intet forlader enheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Handy aus deinen eigenen Belegen und Budgets berechnet. Nichts verlässt das Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculado en este teléfono a partir de tus propios recibos y presupuestos. Nada sale del dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskettu tällä puhelimella omista kuiteistasi ja budjeteistasi. Mikään ei poistu laitteelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculé sur ce téléphone à partir de vos propres reçus et budgets. Rien ne quitte l'appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcolato su questo telefono dai tuoi scontrini e budget. Niente esce dal dispositivo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beregnet på denne telefonen ut fra dine egne kvitteringer og budsjetter. Ingenting forlater enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berekend op deze telefoon op basis van je eigen bonnen en budgetten. Niets verlaat je toestel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obliczono na tym telefonie na podstawie Twoich paragonów i budżetów. Nic nie opuszcza urządzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculado neste celular a partir dos seus próprios recibos e orçamentos. Nada sai do dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculat pe acest telefon din propriile tale bonuri și bugete. Nimic nu părăsește dispozitivul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рассчитано на этом телефоне по вашим чекам и бюджетам. Ничего не покидает устройство."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beräknas på den här telefonen utifrån dina egna kvitton och budgetar. Inget lämnar enheten."
          }
        }
      }
    },
