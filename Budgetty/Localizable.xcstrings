    "Found on this phone by matching repeat charges in your receipts. Yearly items count as one twelfth per month." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открити на този телефон чрез съпоставяне на повтарящи се плащания в бележките ти. Годишните елементи се броят като една дванадесета на месец."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nalezeno v tomto telefonu porovnáním opakovaných plateb ve vašich účtenkách. Roční položky se počítají jako jedna dvanáctina za měsíc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fundet på denne telefon ved at matche gentagne opkrævninger i dine kvitteringer. Årlige poster tæller som en tolvtedel om måneden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Telefon gefunden durch Abgleich wiederkehrender Zahlungen in deinen Belegen. Jährliche Posten zählen als ein Zwölftel pro Monat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontradas en este teléfono al detectar cargos repetidos en tus recibos. Los elementos anuales cuentan como un doceavo al mes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnistettu tässä puhelimessa etsimällä toistuvia maksuja kuiteistasi. Vuosittaiset kohteet lasketaan yhtenä kahdestoistaosana kuukaudessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvés sur ce téléphone en repérant les prélèvements récurrents dans vos reçus. Les éléments annuels comptent pour un douzième par mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trovati su questo telefono confrontando gli addebiti ricorrenti nei tuoi scontrini. Le voci annuali contano per un dodicesimo al mese."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funnet på denne telefonen ved å matche gjentatte betalinger i kvitteringene dine. Årlige oppføringer teller som en tolvtedel per måned."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gevonden op deze telefoon door terugkerende betalingen in je bonnen te matchen. Jaarlijkse posten tellen als een twaalfde per maand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znalezione na tym telefonie przez dopasowanie powtarzających się opłat w Twoich paragonach. Pozycje roczne liczą się jako jedna dwunasta miesięcznie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontradas neste telefone ao cruzar cobranças repetidas nos seus recibos. Os itens anuais contam como um doze avos por mês."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Găsite pe acest telefon prin potrivirea plăților repetate din bonurile tale. Elementele anuale contează ca a douăsprezecea parte pe lună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдено на этом телефоне по повторяющимся списаниям в ваших чеках. Годовые позиции считаются как одна двенадцатая в месяц."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hittade på den här telefonen genom att matcha upprepade betalningar i dina kvitton. Årliga poster räknas som en tolftedel per månad."
          }
        }
      }
    },
