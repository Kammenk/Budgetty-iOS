    "The chart now fits spend plus bills, so the scale changed. The amounts didn't." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chart now fits spend plus bills, so the scale changed. The amounts didn't."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Графиката вече побира похарченото плюс сметките, затова мащабът се промени. Сумите — не."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graf teď pojme výdaje plus účty, takže se změnilo měřítko. Částky ne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagrammet rummer nu forbrug plus regninger, så skalaen ændrede sig. Beløbene gjorde ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Diagramm fasst jetzt Ausgaben plus Rechnungen, daher hat sich der Maßstab geändert. Die Beträge nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El gráfico ahora incluye el gasto más los pagos, así que la escala cambió. Los importes no."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaavioon mahtuu nyt menot plus laskut, joten asteikko muuttui. Summat eivät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le graphique intègre désormais les dépenses plus les factures, donc l'échelle a changé. Pas les montants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il grafico ora contiene la spesa più le spese previste, quindi la scala è cambiata. Gli importi no."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagrammet rommer nå forbruk pluss regninger, så skalaen endret seg. Beløpene gjorde ikke det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De grafiek omvat nu uitgaven plus rekeningen, dus de schaal is veranderd. De bedragen niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykres mieści teraz wydatki plus rachunki, więc skala się zmieniła. Kwoty nie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O gráfico agora comporta o gasto mais as contas, então a escala mudou. Os valores não."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graficul cuprinde acum cheltuielile plus facturile, așa că scara s-a schimbat. Sumele nu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь на графике умещаются траты плюс счета, поэтому масштаб изменился. Суммы — нет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagrammet rymmer nu utgifter plus räkningar, så skalan ändrades. Beloppen gjorde inte det."
          }
        }
