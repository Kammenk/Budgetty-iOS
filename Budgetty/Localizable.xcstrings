        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni %1$@ e di nuovo il %2$@ per il mese. Quello settimanale è un check rapido."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver %1$@, og igjen den %2$@ for måneden. Den ukentlige er en kort sjekk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke %1$@, en opnieuw op %2$@ voor de maand. De wekelijkse is een korte check."
