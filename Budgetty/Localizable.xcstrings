    "Every %@, and again on %@ for the month. The weekly one is a short momentum check." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всеки %1$@ и отново на %2$@ за месеца. Седмичното е кратка проверка."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé %1$@ a znovu %2$@ za měsíc. Týdenní je krátká kontrola."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver %1$@, og igen den %2$@ for måneden. Den ugentlige er et hurtigt tjek."
