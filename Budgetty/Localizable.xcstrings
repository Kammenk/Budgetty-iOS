        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W każdy %1$@ i ponownie %2$@ za miesiąc. Tygodniowe to krótkie sprawdzenie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda %1$@, e novamente em %2$@ para o mês. O semanal é uma verificação rápida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În fiecare %1$@ și din nou pe %2$@ pentru lună. Cel săptămânal e o verificare scurtă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый %1$@ и снова %2$@ за месяц. Недельный — короткая проверка динамики."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje %1$@ och igen den %2$@ för månaden. Den veckovisa är en kort avstämning."
          }
        }
      }
    },
    "Not a notification. It appears the next time you open Budgetty after the period ends, once per period, and closes to Home." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не е известие. Появява се при следващото отваряне на Budgetty след края на периода, веднъж на период, и се затваря към Начало."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není to oznámení. Zobrazí se při příštím otevření Budgetty po skončení období, jednou za období, a zavře se na Domů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke en notifikation. Den vises, næste gang du åbner Budgetty efter periodens slutning, én gang pr. periode, og lukker til Start."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Benachrichtigung. Er erscheint, wenn du Budgetty nach dem Periodenende das nächste Mal öffnest, einmal pro Periode, und schließt zur Startseite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es una notificación. Aparece la próxima vez que abras Budgetty tras terminar el periodo, una vez por periodo, y se cierra al Inicio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei ilmoitus. Se näkyy, kun avaat Budgettyn seuraavan kerran jakson päätyttyä, kerran jaksossa, ja sulkeutuu Etusivulle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n'est pas une notification. Il apparaît à la prochaine ouverture de Budgetty après la fin de la période, une fois par période, et se ferme vers l'Accueil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è una notifica. Appare la prossima volta che apri Budgetty dopo la fine del periodo, una volta per periodo, e si chiude alla Home."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke et varsel. Det vises neste gang du åpner Budgetty etter at perioden er over, én gang per periode, og lukkes til Hjem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen melding. Het verschijnt de volgende keer dat je Budgetty opent na het einde van de periode, eenmaal per periode, en sluit naar Start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To nie powiadomienie. Pojawia się przy następnym otwarciu Budgetty po zakończeniu okresu, raz na okres, i zamyka się do ekranu głównego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é uma notificação. Aparece na próxima vez que abrir o Budgetty após o fim do período, uma vez por período, e fecha para o Início."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu este o notificare. Apare data următoare când deschizi Budgetty după încheierea perioadei, o dată pe perioadă, și se închide spre Acasă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это не уведомление. Появляется при следующем открытии Budgetty после окончания периода, один раз за период, и закрывается на Главный экран."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen avisering. Den visas nästa gång du öppnar Budgetty efter periodens slut, en gång per period, och stängs till Start."
          }
        }
      }
    },
    "Turn this on to get a short summary when a month or week closes. You can still open the last one from Insights." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включете за кратко резюме, когато приключи месец или седмица. Можете да отворите последното от Анализи."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte pro krátký souhrn, když skončí měsíc nebo týden. Poslední můžete stále otevřít v Přehledech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå til for et kort resumé, når en måned eller uge slutter. Du kan stadig åbne den seneste fra Indsigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere dies für eine kurze Zusammenfassung, wenn ein Monat oder eine Woche endet. Den letzten kannst du weiterhin unter Statistiken öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívalo para recibir un breve resumen cuando termine un mes o una semana. Aún puedes abrir el último desde Estadísticas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota käyttöön saadaksesi lyhyen yhteenvedon, kun kuukausi tai viikko päättyy. Voit yhä avata viimeisimmän Havainnot-näkymästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez pour recevoir un court résumé à la fin d'un mois ou d'une semaine. Vous pouvez toujours rouvrir le dernier depuis Analyses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivalo per ricevere un breve riepilogo quando finisce un mese o una settimana. Puoi comunque riaprire l'ultimo da Statistiche."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på for en kort oppsummering når en måned eller uke avsluttes. Du kan fortsatt åpne den siste fra Innsikt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet dit aan voor een korte samenvatting wanneer een maand of week eindigt. Je kunt de laatste nog openen via Inzichten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz, aby otrzymać krótkie podsumowanie, gdy kończy się miesiąc lub tydzień. Ostatnie nadal możesz otworzyć w Statystykach."
          }
        },
        "pt" : {
          "stringUnit" : {
