    "Tap to show or hide a section. Use Edit to drag and reorder. Applies on iPhone." : {
      "comment" : "A description of the Home customization sheet.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докоснете, за да покажете или скриете секция. Използвайте Редактиране, за да пренаредите. Важи за iPhone."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím zobrazíte nebo skryjete sekci. Pomocí Upravit změníte pořadí. Platí na iPhonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at vise eller skjule en sektion. Brug Rediger til at omarrangere. Gælder på iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe, um einen Bereich ein- oder auszublenden. Mit Bearbeiten neu anordnen. Gilt auf dem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para mostrar u ocultar una sección. Usa Editar para reordenar. Se aplica en iPhone."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta näyttääksesi tai piilottaaksesi osion. Järjestä uudelleen Muokkaa-toiminnolla. Koskee iPhonea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour afficher ou masquer une section. Utilisez Modifier pour réorganiser. Sur iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per mostrare o nascondere una sezione. Usa Modifica per riordinare. Vale su iPhone."
